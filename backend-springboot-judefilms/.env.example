# ========================================
# Variables de entorno del Backend (Spring Boot)
# ========================================
# Copia este archivo como .env y completa los valores.
# Puedes cargarlas en tu sistema o usar un plugin de Spring para leer .env

# --- Base de Datos ---
DB_URL=jdbc:mysql://TU_HOST:3306/db_backend_judefilms?createDatabaseIfNotExist=true
DB_USERNAME=root
DB_PASSWORD=TU_PASSWORD_DE_BD

# --- Seguridad / Admin ---
ADMIN_USER=jude
ADMIN_PASSWORD=TU_PASSWORD_ADMIN
ADMIN_ROLE=ADMIN

# --- Cloudflare R2 (Storage) ---
R2_ACCESS_KEY=TU_ACCESS_KEY
R2_SECRET_KEY=TU_SECRET_KEY
R2_ENDPOINT=https://TU_ACCOUNT_ID.r2.cloudflarestorage.com
R2_BUCKET_NAME=judefilms-contratos
R2_PUBLIC_URL=https://TU_PUBLIC_URL.r2.dev

# --- CORS (separar múltiples orígenes con coma) ---
CORS_ALLOWED_ORIGINS=https://tu-dominio.com

# --- JPA ---
JPA_DDL_AUTO=update
JPA_SHOW_SQL=false
